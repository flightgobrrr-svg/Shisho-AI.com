# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example holds no secrets. It is the template that tells anyone
# cloning this repo which variables to set, so it must be committed.
!.env.example

# local editor/agent settings — machine-specific, not project config
.claude/settings.local.json
# locally-installed agent skill packs, not part of this project
.claude/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tool output and config, not part of this project
# graphify knowledge-graph output (regenerated on demand)
graphify-out/
# an export of Claude settings and skills
claude-export/
claude-export.zip
# MCP server config for this machine's agent tools
.mcp.json
