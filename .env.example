# Copy to .env.local (already gitignored) and fill in.
#
# SERVER-ONLY. Never rename this to NEXT_PUBLIC_ANTHROPIC_API_KEY — anything
# with that prefix is inlined into the client bundle and shipped to browsers.
# Shared by app/api/draft/route.ts and app/api/assistant/route.ts, both of
# which run on the Node runtime and read it independently.
ANTHROPIC_API_KEY=

# Force demo mode for the draft reviewer even when a key is present. Leave
# unset for normal behaviour: the route falls back to demo automatically
# whenever ANTHROPIC_API_KEY is absent.
# SHISHO_DRAFT_MODE=demo

# Force demo mode for the drafting agent even when a key is present.
# Independent of SHISHO_DRAFT_MODE above — you can demo the reviewer live
# while forcing the agent to demo, or vice versa.
# SHISHO_ASSISTANT_MODE=demo
