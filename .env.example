# Copy to .env.local (already gitignored) and fill in.
#
# SERVER-ONLY. Never rename this to NEXT_PUBLIC_ANTHROPIC_API_KEY — anything
# with that prefix is inlined into the client bundle and shipped to browsers.
# It is read only in app/api/draft/route.ts, which runs on the Node runtime.
ANTHROPIC_API_KEY=

# Force demo mode even when a key is present. Leave unset for normal behaviour:
# the route falls back to demo automatically whenever ANTHROPIC_API_KEY is absent.
# SHISHO_DRAFT_MODE=demo
