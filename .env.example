# Copy to .env.local (already gitignored) and fill in.
#
# SERVER-ONLY. Never rename this to NEXT_PUBLIC_ANTHROPIC_API_KEY — anything
# with that prefix is inlined into the client bundle and shipped to browsers.
# Shared by app/api/draft/route.ts and app/api/assistant/route.ts, both of
# which run on the Node runtime and read it independently.
ANTHROPIC_API_KEY=

# SERVER-ONLY. Free-tier key for app/api/assistant/route.ts's drafting agent
# (the /draft-bot chat) — get one at https://aistudio.google.com/apikey with
# any Google account, no billing setup required. When this is set, the agent
# uses Gemini instead of ANTHROPIC_API_KEY for live mode (tried first if both
# are set); leaving both empty keeps the agent in demo mode. The draft
# reviewer at app/api/draft/route.ts is unaffected either way — it only
# reads ANTHROPIC_API_KEY, never this one.
GEMINI_API_KEY=

# Force demo mode for the draft reviewer even when a key is present. Leave
# unset for normal behaviour: the route falls back to demo automatically
# whenever ANTHROPIC_API_KEY is absent.
# SHISHO_DRAFT_MODE=demo

# Force demo mode for the drafting agent even when a key is present.
# Independent of SHISHO_DRAFT_MODE above — you can demo the reviewer live
# while forcing the agent to demo, or vice versa.
# SHISHO_ASSISTANT_MODE=demo

# SERVER-ONLY. From your Supabase project's Settings -> API. The
# service_role key bypasses Row Level Security by design — see
# lib/supabase.ts for why that's the intended trust model here, not an
# oversight. Never prefix either with NEXT_PUBLIC_.
#
# Optional in the sense that nothing crashes without them: usage counters
# (lib/usageCounters.ts) fall back to the previous cookie-only behaviour
# until both are set, then switch over automatically — no flag, no redeploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. From the SAME Supabase project as above — Settings -> API ->
# "anon" / "publishable" key (Supabase has renamed this in the dashboard at
# different times; it's the OTHER key on that page, not service_role). Used
# by lib/authSession.ts for real user accounts (register/login/logout,
# lib/authSession.ts, app/api/auth/*), never for the data tables above,
# which stay on the service_role client (lib/supabase.ts) exactly as before.
# This key is designed to be safe even if exposed publicly (Row Level
# Security is the real boundary) — it's kept server-only here anyway because
# nothing in this app runs Supabase JS in the browser; see lib/authSession.ts
# for why that's a deliberate choice, not an oversight.
#
# Optional in the same sense as SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above:
# without it, register/login/etc. return a plain "accounts aren't set up
# yet" error and the rest of the site (including the anonymous free-trial
# quota) is completely unaffected.
SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Any long random string you generate yourself (not from a
# third party) — Vercel sends it back as `Authorization: Bearer <value>`
# when it triggers a scheduled cron job (see vercel.json), which is how
# app/api/cron/ingest-judgments tells a real Vercel-triggered run apart
# from anyone hitting the URL directly. The ingestion source itself
# (lib/openJudgments.ts, the public AWS Open Data judgments bucket) is free
# and needs no key of its own — but this route still writes to Supabase on
# every run, so it is required: without it, the route refuses every
# request (503), including Vercel's own scheduled runs.
CRON_SECRET=

# SERVER-ONLY. The shared secret for /admin/review (lib/adminAuth.ts) — the
# review-queue UI that approves or rejects pending_review rows the
# ingestion cron writes. Single-secret gate, no accounts: this project has
# no auth system, and one reviewer doesn't need one. Set this in Vercel too
# before deploying, same as CRON_SECRET.
REVIEW_SECRET=

# SERVER-ONLY. Google Cloud Console -> APIs & Services -> Credentials ->
# your OAuth 2.0 Client ID (type: Web application). Used by
# lib/googleDrive.ts to build the Drive consent URL and exchange the
# returned code for a refresh token (app/api/drive/connect,
# app/api/drive/callback). A real secret pair — never prefix NEXT_PUBLIC_,
# unlike the Picker key below. Requires the Google Drive API and Google
# Picker API enabled on the same Cloud project, and an authorized redirect
# URI matching /api/drive/callback exactly (see HANDOFF.md for the full
# Google Cloud setup checklist).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CLIENT-VISIBLE BY DESIGN — the one intentional exception in this file.
# Google Cloud Console -> APIs & Services -> Credentials -> API key,
# restricted (in the Cloud Console, not here) to the Google Picker API and
# to this site's own HTTP referrers. Used only by
# components/draft/DriveConnect.tsx to authorize the Picker widget's own
# calls when a visitor chooses their templates folder. The referrer
# restriction is the real protection here, not secrecy — Google's own
# design expects this specific key to be readable client-side.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Public contact address shown on /contact. Leave empty until a real,
# monitored mailbox exists; the page says contact details are coming.
NEXT_PUBLIC_CONTACT_EMAIL=

# Razorpay, for buying a plan in the app (lib/payments.ts). SERVER-ONLY: never
# prefix with NEXT_PUBLIC_. Use the test-mode keys from the Razorpay dashboard
# while testing. Without the two keys, /api/mobile/pay answers 503 and nothing
# is charged. The webhook secret is the one you set when adding the webhook
# (URL: <site>/api/pay/razorpay/webhook, event: payment_link.paid).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
