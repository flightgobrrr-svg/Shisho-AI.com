{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shisho-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "shisho-mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081,
      "autoPort": true
    }
  ]
}
